# Reference for the EXISTING /opt/olympic/.env, owner deploy user, mode600.
# Do not overwrite, move or copy the operator file during deployment.
# This template contains no working secrets. Never commit the filled file.
# Keep application keys stable across releases. Compose dotenv quoting applies.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_SALT=
OLYMPIC_ADMIN_EMAIL=
OLYMPIC_ADMIN_USERNAME=
OLYMPIC_ADMIN_PASSWORD=
OLYMPIC_ADMIN_FULL_NAME=Olympic Learning Platform Administrator
# This cap does not prove a small host can run/build the stack; measure capacity.
API_MEMORY_LIMIT=2g
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Preserve existing registration policy; enable SELF_VERIFY only by operator decision.
OLYMPIC_AUTH_REGISTRATION_MODE=ADMIN_ONLY
OLYMPIC_MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_SSL_CHECKSERVERIDENTITY=true
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Existing YAML declares both OAuth registrations. Supply valid registration
# configuration; blank client IDs can prevent Spring startup. No fake production IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING_TEXT=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
DEEPSEEK_API_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=olympic.nghlong3004.me
TURNSTILE_TIMEOUT=2s

# Public web build flags; must match backend protection/hostname policy.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
